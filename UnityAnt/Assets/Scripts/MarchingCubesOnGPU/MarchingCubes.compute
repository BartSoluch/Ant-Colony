#pragma kernel CSMain
#define P 1 // Must match the C# side padding

struct Vert
{
    float4 position;
    float3 normal;
};

RWStructuredBuffer<Vert> _Buffer; // Triangle buffer
StructuredBuffer<float> _Voxels;
StructuredBuffer<int> _CubeEdgeFlags;
StructuredBuffer<int> _TriangleConnectionTable;
RWBuffer<int> _VertexIndexBuffer; // Counter buffer
float3 _ChunkWorldPosition;

int _Width;
int _Height;
int _Depth;
int _Border;
float _Target;

static const int3 CornerOffsets[8] =
{
    int3(0, 0, 0), int3(1, 0, 0), int3(1, 1, 0), int3(0, 1, 0),
    int3(0, 0, 1), int3(1, 0, 1), int3(1, 1, 1), int3(0, 1, 1)
};

static const int EdgeVertexMap[12][2] =
{
    { 0, 1 },
    { 1, 2 },
    { 2, 3 },
    { 3, 0 },
    { 4, 5 },
    { 5, 6 },
    { 6, 7 },
    { 7, 4 },
    { 0, 4 },
    { 1, 5 },
    { 2, 6 },
    { 3, 7 }
};

[numthreads(8, 8, 8)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (_Width - 1 - P) || id.y >= (_Height - 1 - P) || id.z >= (_Depth - 1 - P))
        return;

    float values[8];
    float3 positions[8];
    int cubeIndex = 0;

    int3 paddedID = int3(id.x + P, id.y + P, id.z + P);
    for (int j = 0; j < 8; j++)
    {
        int3 corner = paddedID + CornerOffsets[j];
        int index = corner.x + corner.y * _Width + corner.z * _Width * _Height;
        float val = _Voxels[index];
        values[j] = val;
        positions[j] = corner;
        if (val > _Target)
            cubeIndex |= (1 << j);
    }

    int edgeFlags = _CubeEdgeFlags[cubeIndex];
    if (edgeFlags == 0)
        return;

    float3 edgeVertices[12];
    for (int i = 0; i < 12; i++)
    {
        uint flags = asuint(edgeFlags);
        if ((flags & (1u << i)) == 0)
            continue;

        int a = EdgeVertexMap[i][0];
        int b = EdgeVertexMap[i][1];
        float3 p1 = positions[a];
        float3 p2 = positions[b];
        float v1 = values[a];
        float v2 = values[b];
        float t = (v2 - v1) == 0 ? 0.5 : (_Target - v1) / (v2 - v1);
        t = clamp(t, 0.0, 1.0);
        edgeVertices[i] = lerp(p1, p2, t);
    }

    for (int triIndex = 0; triIndex < 16; triIndex += 3)
    {
        int a = _TriangleConnectionTable[cubeIndex * 16 + triIndex + 0];
        int b = _TriangleConnectionTable[cubeIndex * 16 + triIndex + 1];
        int c = _TriangleConnectionTable[cubeIndex * 16 + triIndex + 2];
        if (a < 0 || b < 0 || c < 0)
            break;

        float3 pa = edgeVertices[a];
        float3 pb = edgeVertices[b];
        float3 pc = edgeVertices[c];

        float3 normal = normalize(cross(pb - pa, pc - pa));

        Vert v;
        v.normal = normal;

        int baseIndex;
        InterlockedAdd(_VertexIndexBuffer[0], 3, baseIndex); // 3 vertices per triangle

        v.position = float4(pa + _ChunkWorldPosition, 1);
        _Buffer[baseIndex + 0] = v;

        v.position = float4(pb + _ChunkWorldPosition, 1);
        _Buffer[baseIndex + 1] = v;

        v.position = float4(pc + _ChunkWorldPosition, 1);
        _Buffer[baseIndex + 2] = v;
    }
}
